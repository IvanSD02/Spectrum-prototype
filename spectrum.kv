                                root.check_click(self, self.active, root.ids.p8.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p9
                    text: "Hobby Roulette"
                    secondary_text: "Have all your movie and series titles in one place!"
                    icon: "movie"

                    IconLeftWidget:
                        id: i9
