                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p910
                            on_active:
                                #root.is_clicked(self, self.active, root.ids.p9.text)
                                root.check_click(self, self.active, root.ids.p9.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p10
                    text: "Find Your Home!"
                    secondary_text: "Don't ever forget the path to your home!"
                    icon: "map"

                    IconLeftWidget:
                        id: i10
                        icon: "map" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p1010
                            on_active:
                                #root.is_clicked(self, self.active, root.ids.p10.text)
                                root.check_click(self, self.active, root.ids.p10.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p11
                    text: "Speech To Text"
                    secondary_text: "Convert your voice to written text! (COMING SOON!)"
                    icon: "map"

                    IconLeftWidget:
                        id: i11
                        icon: "volume-high" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p1110
                            on_active:
                                #root.is_clicked(self, self.active, root.ids.p11.text)
                                root.check_click(self, self.active, root.ids.p11.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p12
                    text: "Chat Room"
                    secondary_text: "Find friends to talk with! (COMING SOON!)"
                    icon: "map"

                    IconLeftWidget:
                        id: i12
                        icon: "chat" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p1210
                            on_active:
                                #root.is_clicked(self, self.active, root.ids.p12.text)
                                root.check_click(self, self.active, root.ids.p12.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)


                TwoLineAvatarIconListItem:
                    id: p13
                    text: "Anti-Stress Doodles"
                    secondary_text: "A magic pen will doodle for you and create figures, while you relax!(COMING SOON!)"
                    icon: "map"

                    IconLeftWidget:
                        id: i13
                        icon: "brush-variant" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p1310
                            on_active:
                                #root.is_clicked(self, self.active, root.ids.p13.text)
                                root.check_click(self, self.active, root.ids.p13.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)


        HoverButtonSaveChecks:
            id: cm
            text: "Save"
            font_size: 20
            size_hint: .10, .10
            on_release: root.save_checked()

<CustomDialog>:
    title: "Please follow the guideline below:"
    text: "For a strong password you should include the following:\n - one capital letter\n - two small letters\n - one number\n - one special symbol (!, @, #, $, %, ^, &, *)\n"
    elevation: 6
    shadow_radius: 18
    shadow_softness: 24
    shadow_offset: 12, 12
    radius: [20, 20, 20, 20]

    BoxLayout:
        orientation: 'vertical'
        padding: (0, 0, 0, 20)
        MDFlatButton:
            size_hint_y: None
            elevation: 5
            pos_hint:{"center_x": 0.5}
            text: "OK"
            theme_text_color: "Custom"
            text_color: self.theme_cls.primary_color
            on_release: root.dismiss()


<ProfilePage>:
    name: 'profile_page'

    AnchorLayout:
        anchor_y:'top'

        MDGridLayout:
            cols:1
            #padding:20
            #spacing:20

            MDTopAppBar:
                id: top
                title: "SPECTRUM"
                #md_bg_color: app.theme_cls.accent_color
                left_action_items: [["menu", lambda x: root.drop_func(x)]]
                right_action_items: [["theme-light-dark", lambda x: root.change_theme(app)], ["brush-variant", lambda x: root.change_but_color(app, root)], ["palette", lambda x: root.show_theme_picker(app)]]

            ScrollView:
                size_hint_x: 1
                size_hint_y: None
                size: 800, 600

                GridLayout:
                    cols:3
                    row_default_height: 250
                    row_force_default: True
                    height: 900
                    padding:[dp(15),dp(15),dp(15),dp(40)]
                    spacing:dp(25)
                    size_hint_y: None

                    ElementCard:
                        image: "resources/to-do.png"
                        id: e4
                        text:"To-Do List"
                        on_release:
                            app.root.current = "todolist"

                    ElementCard:
                        image: "resources/hobby.png"
                        id: e9
                        text:"Hobby Roulette"
                        on_release:
                            app.root.current = "hobbyroulette"

                    ElementCard:
                        image: "resources/cart.png"
                        id: e7
                        text:"Shopping List"
                        on_release:
                            app.root.current = "shopping"

                    ElementCard:
                        image: "resources/map.png"
                        id: e10
                        text:"Find Your Home!"
                        on_release:
                            app.root.current = "findyourhome"

                    ElementCard:
                        image: "resources/emotion.png"
                        id: e2
                        text:"Emotions Diary"
                        on_release:
                            app.root.current = "emotion"

                    ElementCard:
                        image: "resources/speech.png"
                        id: e6
                        text:"Text To Speech"
                        on_release:
                            app.root.current = "texttospeech"

                    ElementCard:
                        image: "resources/diary.png"
                        id: e1
                        text:"Daily Diary"
                        on_release:
                            app.root.current = "dailydiary"

                    ElementCard:
                        image: "resources/doodle.png"
                        id: e13
                        text:"Anti-Stress Doodles"
                        on_release:
                            app.root.current = "doodles"


            MDBottomAppBar
                MDTopAppBar:
                    id: bot
                    title: "ORGANISE YOUR SPACE!"
                    icon: "plus"
                    type: "bottom"
                    #on_action_button: root.create_page()
                    on_action_button:
                        root.manager.transition.direction = "right"
                        root.create_page()
                    right_action_items: [["emoticon-happy", lambda x: root.show_confirmation_dialog()]]

<ElementCard@MDCard>:
   #size: "280dp", "180dp"
    #pos_hint: {"center_x": .5, "center_y": .5}
    md_bg_color: "wheat"
    padding:dp(15)
    spacing:dp(15)
    radius:dp(25)
    ripple_behavior: True
    elevation: 3
    image:''
    text:""

    orientation:'vertical'
    Image:
        size_hint_y:.90
        source:root.image
    MDLabel:
        halign: "center"
        size_hint_y:.10
        text:root.text

<ListItem@OneLineAvatarIconListItem>:
    IconLeftWidget:
        id: i1
        icon:"shopping-outline"
    ItemCheckBox:

<TodoCard>:
    done: root.out_done

    elevation: 2
    md_bg_color: 1,1,1,1
    radius: [8]

    MDFloatLayout:
        id: bar
        size_hint: .01, .9
        pos_hint: {"center_x": .02, "center_y":.5}
        md_bg_color: 1, 170/255, 23/255, 1

    MDLabel:
        id: title
        text: root.title
        markup: True
        font_name: "resources/Poppins-SemiBold.ttf"
        font_size: "20sp"
        size_hint_x: .8
        pos_hint:{"center_x": .46, "center_y": .8}

    Image:
        id: image
        #orientation: "vertical"
        #size_hint: 1, .75
        pos_hint: {"center_x": .75, "center_y": .8}
        source: root.image

    MDCheckbox:
        id: check
        size_hint: None, None
        size:"48dp", "48dp"
        unselected_color: 1,170/255, 23/255,1
        selected_color: 0,179/255, 0,1
        pos_hint:{"center_x": .95, "center_y": .8}
        on_active:
            #root.manager.ids("todolist").on_complete(*args, description, bar)
            root.effects(*args, root.id, title, description, bar)
    MDLabel:
        id: description
        text: root.description
        font_name: "resources/Poppins-Semibold.ttf"
        markup: True
        size_hint_x: .9
        line_height: .8
        pos_hint: {"center_x": .51, "center_y": .4}

    MDLabel:
        id: due_date
        text: root.due_date
        markup: True
        size_hint: .4, .4
        color: "grey"
        font_name: "resources/Poppins-Regular.ttf"
        pos_hint: {"center_x": .8, "center_y": .2}

    MDIconButton:
        id: deleter
        icon: "trash-can"
        user_font_size: "40sp"
        pos_hint: {"center_x":.95, "center_y":.2}
        theme_text_color:"Custom"
        text_color: 1, 170/255, 23/255, 1
        on_release:
            #self.parent.remove_widget(self)
            root.remove_effects(*args, root.id, title, description, bar)

<AddListBox>:
    title: title
    description: description
    priority: image
    due_date: due_date

    name: "add_todo_box"
    MDFloatLayout:
        #md_bg_color: 1,1,1,1
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'white.png'
        MDIconButton:
            icon: "chevron-left"
            user_font_size: "40sp"
            pos_hint: {"center_y":.95}
            theme_text_color:"Custom"
            text_color: 1, 170/255, 23/255, 1
            on_release:
                root.manager.transition.direction = "right"
                root.manager.current = "todolist"
        MDLabel:
            text: "Add Task"
            pos_hint: {"center_x": .8, "center_y":.88}
            font_name: "resources/Poppins-SemiBold.ttf"
            font_size:"35sp"
        MDFloatLayout:
            size_hint: .85, .08
            pos_hint: {"center_x": .5, "center_y":.78}
            canvas:
                Color:
                    rgba:(1,1,1,1)
                RoundedRectangle:
                    size:self.size
                    pos:self.pos
                    radius:[25]
                Line:
                    width: 2
                    rectangle: self.x, self.y, self.width, self.height
            TextInput:
                id: title
                hint_text:"Title"
                hint_text_color: (0,0,0,0.5)
                size_hint:1,None
                pos_hint: {"center_x": .5, "center_y":.5}
                height: self.minimum_height
                multiline: False
                cursor_color: 1, 170/255, 23/255, 1
                cursor_width: "2sp"
                foreground_color: 1, 170/255, 23/255, 1
                background_color:0,0,0,0
                padding:15
                font_name: "resources/Poppins-Regular.ttf"
                font_size:"18sp"
        MDFloatLayout:
            size_hint: .85, .28
            pos_hint: {"center_x": .5, "center_y":.57}
            canvas:
                Color:
                    rgba:(1,1,1,1)
                RoundedRectangle:
                    size:self.size
                    pos:self.pos
                    radius:[25]
                Line:
                    width: 2
                    rectangle: self.x, self.y, self.width, self.height
            TextInput:
                id: description
                hint_text:"Description"
                hint_text_color: (0,0,0,0.5)
                size_hint:1,None
                pos_hint: {"center_x": .5, "center_y":.5}
                height: 180
                cursor_color: 1, 170/255, 23/255, 1
                cursor_width: "2sp"
                foreground_color: 1, 170/255, 23/255, 1
                background_color:0,0,0,0
                padding:15
                font_name: "resources/Poppins-Regular.ttf"
                font_size:"18sp"

        MDFloatLayout:
            size_hint: .85, .08
            pos_hint: {"center_x": .5, "center_y":.36}
            canvas:
                Color:
                    rgba:(1,1,1,1)
                RoundedRectangle:
                    size:self.size
                    pos:self.pos
                    radius:[25]
                Line:
                    width: 2
                    rectangle: self.x, self.y, self.width, self.height
            TextInput:
                id: image
                hint_text:"Priority (1 to 5)"
                hint_text_color: (0,0,0,0.5)
                size_hint:1,None
                pos_hint: {"center_x": .5, "center_y":.5}
                height: self.minimum_height
                multiline: False
                cursor_color: 1, 170/255, 23/255, 1
                cursor_width: "2sp"
                foreground_color: 1, 170/255, 23/255, 1
                background_color:0,0,0,0
                padding:15
                font_name: "resources/Poppins-Regular.ttf"
                font_size:"18sp"

        MDBoxLayout:
            orientation: 'horizontal'
            padding: (55, 30, 55, 15)
            spacing: 10

            MDIconButton:
                icon: 'calendar'
                size_hint: .02, .08
                pos_hint: {"center_x": .35, "center_y":.25}
                md_bg_color: 1, 1, 1, 1
                on_release:
                    root.show_date_picker()

            MDLabel:
                id: due_date
                text: "No Due"
                size_hint: .1, .05
                font_size: 20
                halign: 'center'
                font_name: "resources/Poppins-Regular.ttf"
                pos_hint: {"center_x": .8, "center_y":.25}

                canvas.before:
                    Color:
                        rgba: (1,1,1,1)
                    RoundedRectangle:
                        size:self.size
                        pos:self.pos
                        radius:[25]

        Button:
            text: "ADD TASK"
            size_hint: .45, .08
            pos_hint: {"center_x": .5, "center_y":.15}
            font_name: "resources/Poppins-SemiBold.ttf"
            background_color:0,0,0,0
            font_size:"18sp"
            color:1,1,1,1
            on_release:
                root.manager.get_screen('todolist').add_todo_box(title.text, description.text, image.text, due_date.text, 0)
                #root.manager.current = 'todolist'
            canvas.before:
                Color:
                    rgb:(1, 170/255, 23/255, 1)
                RoundedRectangle:
                    size:self.size
                    pos:self.pos
                    radius:[25]


