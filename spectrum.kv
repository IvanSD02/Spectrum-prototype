<MainPage>:
    name: "main"

    canvas.before:
        Rectangle:
            source: "resources/mainbg.jpg"
            size: root.width, root.height

    FloatLayout:
        orientation: "vertical"

        Label:
            id: title
            opacity: 0
            center: 400, -self.height
            text: "SPECTRUM"
            color:(0, 0, 198, 0.56)
            font_size: 60
            size_hint: .0, .0
            pos_hint:{"center_x":0.5, "y":0.7}
            outline_width: 3
            outline_color:(0, 0 ,0)

        FloatLayout:
            orientation: "vertical"

            HoverButtonMainPage:
                size_hint: 0.2, 0.1
                text: "START"
                pos_hint: {"center_x":0.5, "center_y":0.5}
                font_size: 32
                md_bg_color: (0, 130/255, 242/255, 0.8)
                text_color: 1, 1, 1, 1
                line_width: 2
                line_color: 0, 0, 0, 1
                on_release:
                    root.manager.transition.direction = "left"
                    app.root.current = "login"

    AnchorLayout:
        anchor_x: 'right'
        anchor_y: 'bottom'
        pos_hint: {"x":.075}

        Image:
            source: 'resources/kid.gif'
            size_hint: .3, .3

<LoginPage>:
    name: "login"

    canvas.before:
        Rectangle:
            source: "resources/purple_bg3.jpg"
            size: root.width, root.height

    FloatLayout:

        MDIconButton:
            icon: "chevron-left"
            md_bg_color: "snow"
            size_hint: .05, .06
            user_font_size: "40sp"
            pos_hint: {"center_x":.035, "center_y":.95}
            theme_text_color:"Custom"
            text_color: 1, 170/255, 23/255, 1
            on_release:
                root.manager.transition.direction = "right"
                root.manager.current = "main"

        MDBoxLayout:
            orientation: 'vertical'
            padding: (0, 50, 0, 50)

            MDCard:
                size_hint: 0.6, 0.7
                pos_hint: {"center_x":0.5,"center_y":0.5}
                elevation: 5
                spacing: 25
                orientation: 'vertical'
                line_width:4
                line_color:(0,0,0,0.5)
                padding: (0, 50, 0, 20)
                shadow_radius: 100
                shadow_softness: 60
                radius: [30, 30, 30, 30]

                Label:
                    id: title
                    text: "Your Own PERSONAL Space !"
                    color: "purple"
                    padding: (0, 20, 0, 20)
                    font_size: 40
                    font_style: 'Calibre'
                    size_hint: .1, .1
                    pos_hint: {"center_x":0.5, "y":0.3}
                    outline_width: 3
                    outline_color: (0, 0, 0, 1)

                HoverTextBox:
                    id: uid
                    hint_text: "Username"
                    icon_right: "account"
                    size_hint_x: None
                    width: 200
                    font_size: 20
                    pos_hint: {"center_x": 0.5}

                HoverTextBox:
                    id: pwd
                    hint_text: "Password"
                    icon_right: "lock"
                    size_hint_x: None
                    width: 200
                    font_size: 20
                    pos_hint: {"center_x": 0.5}
                    password: True

                HoverButtonPurpleDesign:
                    text: "LOGIN"
                    font_size: 20
                    pos_hint: {"center_x": 0.5}
                    on_press:
                        root.logIn()
                    line_width: 1.2
                    line_color:"purple"
                    text_color:"purple"
                    md_bg_color:(1,1,1,1)

                HoverButtonPurpleDesign:
                    text: "CLEAR"
                    font_size: 20
                    pos_hint: {"center_x": 0.5}
                    on_press: root.clear()
                    line_width: 1.2
                    line_color:"purple"
                    text_color:"purple"
                    md_bg_color:(1,1,1,1)

                MDLabel:
                    opacity: 0
                    id: error_label
                    text: "Invalid Login"
                    font_size: 14
                    halign: 'center'
                    size_hint_y: None
                    height: self.texture_size[1]
                    pos_hint: {"center_x": 0.5}
                    theme_text_color:'Custom'
                    text_color: 1,0,0,1

                MDLabel:
                    id: signup_label
                    text: "You don't have an account?"
                    font_size: 15
                    halign:'center'
                    pos_hint: {"center_x": 0.5}
                    text_color: 0,0,1,0

                HoverButtonPurpleDesign:
                    id: signup_button
                    text: "SIGN UP"
                    font_size: 25
                    pos_hint: {"center_x": 0.5}
                    line_width: 2
                    theme_text_color: "Custom"
                    line_color:"purple"
                    text_color:"purple"
                    md_bg_color:(1,1,1,1)
                    on_release:
                        root.manager.transition.direction = "left"
                        app.root.current = "signup"

                MDAnchorLayout:
                    anchor_x: 'right'
                    anchor_y: 'bottom'
                    size_hint: 20.1, 20.1
                    pos_hint: {"center_x": 0.5}

                    Image:
                        id: circle
                        opacity: 0
                        source: 'resources/circle.gif'


<SignupPage>:
    name:'signup'

    canvas.before:
        Rectangle:
            source: 'resources/purple_bg2.png'
            size: root.width, root.height

    MDIconButton:
        icon: "chevron-left"
        md_bg_color: "snow"
        size_hint: .05, .06
        user_font_size: "40sp"
        pos_hint: {"center_x":.035, "center_y":.95}
        theme_text_color:"Custom"
        text_color: 1, 170/255, 23/255, 1
        on_release:
            root.manager.transition.direction = "right"
            root.manager.current = "main"

    BoxLayout:
        orientation: 'vertical'
        padding: (0, 50, 0, 50)

        MDCard:
            size_hint: 0.6, 0.7
            pos_hint: {"center_x":0.5,"center_y":0.5}
            elevation: 5
            spacing: 25
            padding: (0, 50, 0, 100)
            orientation: 'vertical'
            line_width:4
            line_color:(0,0,0,0.5)
            shadow_radius: 100
            shadow_softness: 60
            radius: [30, 30, 30, 30]

            Label:
                id: title
                text: "Create an account"
                color:"purple"
                font_size:50
                size_hint:.1,.1
                pos_hint:{"center_x":0.5, "y":0.3}
                outline_width: 3
                outline_color:(0,0,0,1)

            HoverTextBox:
                id: uid
                hint_text: "Username"
                icon_right: "account"
                size_hint_x: None
                width: 200
                font_size: 20
                pos_hint: {"center_x": 0.5}

            HoverTextBox:
                id: pwd
                hint_text: "Password"
                icon_right: "lock"
                size_hint_x: None
                width: 200
                font_size: 20
                pos_hint: {"center_x": 0.5}
                password: True

            HoverTextBox:
                id: repwd
                hint_text: "Repeat Password"
                icon_right: "lock"
                size_hint_x: None
                width: 200
                font_size: 20
                pos_hint: {"center_x": 0.5}
                password: True

            MDLabel:
                opacity: 0
                id: error_label
                text: "Account already exists!"
                font_size: 14
                halign: 'center'
                size_hint_y: None
                height: self.texture_size[1]
                pos_hint: {"center_x": 0.5}
                theme_text_color:'Custom'
                text_color: 1,0,0,1

            HoverButtonPurpleDesign:
                id: signup_button
                text: "SIGN UP"
                font_size: 25
                pos_hint: {"center_x": 0.5}
                line_width: 2
                theme_text_color: "Custom"
                line_color: "black"
                text_color: "black"
                md_bg_color: (1, 1, 1, 1)
                on_press: root.create_account()

            HoverButtonPurpleDesign:
                id: back_button
                text: "GO BACK"
                font_size: 25
                pos_hint: {"center_x": 0.5}
                line_width: 2
                theme_text_color: "Custom"
                line_color:"purple"
                text_color:"purple"
                md_bg_color:(1,1,1,1)

                on_release:
                    root.manager.transition.direction = "right"
                    app.root.current = "login"

<SuccessfulSignupPage>:
    name: 'success'

    canvas.before:
        Rectangle:
            pos: self.pos
            size: self.size
            source: 'resources/purple_bg4.png'

    MDCard:
        md_bg_color: "wheat"
        size_hint:.8,.5
        pos_hint:{"center_x":0.5, "center_y":0.5}
        elevation: 5
        padding: 25
        spacing: 25
        orientation: 'vertical'
        line_width:4
        line_color:(0,0,0,0.5)
        shadow_radius: 100
        shadow_softness: 60
        radius: [30, 30, 30, 30]

        Label:
            id: title
            text: "Successfully created!"
            color: "purple"
            font_size: 50
            size_hint: .1,.1
            pos_hint: {"center_x":0.5, "y":0.3}
            outline_width: 3
            outline_color: (0, 0, 0, 1)

        HoverButtonPurpleDesign:
            id: signup_button
            text: "LOGIN"
            font_size: 25
            pos_hint: {"center_x": 0.5}
            line_width: 2
            theme_text_color: "Custom"
            line_color:"purple"
            text_color:"purple"
            md_bg_color: (1, 1, 1, 1)
            on_release:
                root.manager.transition.direction = "right"
                app.root.current = "login"

<ChooseTypeAccountPage>:
    name: "choose_type_account"

    canvas.before:
        Rectangle:
            pos: self.pos
            size: self.size
            source: 'resources/orange_bg2.jpg'

    BoxLayout:
        orientation: 'horizontal'
        spacing: 40
        padding: (40, 0, 40, 0)

        HoverCardChooseProfile:
            orientation: 'vertical'
            size_hint: 0.3, 0.5
            pos_hint: {"center_x":0.5, "center_y":0.5}
            font_size: 32
            md_bg_color: (255, 255, 255, 1)
            text_color: 1, 1, 1, 1
            line_width: 2
            line_color: 0, 0, 0, 1
            elevation: 3
            spacing: 25
            padding: (0, 50, 0, 50)
            shadow_radius: 50
            shadow_softness: 60
            radius: [30, 30, 30, 30]

            on_release:
                root.manager.transition.direction = "left"
                app.root.current = "checks_page"

            Image:
                pos_hint: {"center_x":0.5, "center_y":0.5}
                source: 'resources/adult_with_kid.png'
                size_hint: .5, .5

            Label:
                text: "PARENTAL"
                color: (0, 130/255, 242/255, 0.8)
                padding: (0, 20, 0, 20)
                font_size: 40
                font_style: 'Calibre'
                size_hint: .1, .1
                pos_hint: {"center_x":0.5, "y":0.3}
                outline_width: 3
                outline_color: (0, 0, 0, 1)

        HoverCardChooseProfile:
            orientation: 'vertical'
            size_hint: 0.3, 0.5
            pos_hint: {"center_x":0.5, "center_y":0.5}
            font_size: 32
            md_bg_color: (255, 255, 255, 1)
            text_color: 1, 1, 1, 1
            line_width: 2
            line_color: 0, 0, 0, 1
            elevation: 3
            spacing: 25
            padding: (0, 50, 0, 50)
            shadow_radius: 50
            shadow_softness: 60
            radius: [30, 30, 30, 30]

            on_release:
                root.manager.transition.direction = "left"
                app.root.current = "checks_page"

            Image:
                pos_hint: {"center_x":0.5, "center_y":0.5}
                source: 'resources/adult.png'
                size_hint: .5, .5

            Label:
                text: "PERSONAL"
                color: (0, 130/255, 242/255, 0.8)
                padding: (0, 20, 0, 20)
                font_size: 40
                font_style: 'Calibre'
                size_hint: .1, .1
                pos_hint: {"center_x":0.5, "y":0.3}
                outline_width: 3
                outline_color: (0, 0, 0, 1)

<CheckFunctionalitiesPage>
    name: "checks_page"

    MDIconButton:
        icon: "chevron-left"
        md_bg_color: "snow"
        size_hint: .05, .06
        user_font_size: "40sp"
        pos_hint: {"center_x":.035, "center_y":.95}
        theme_text_color:"Custom"
        text_color: 1, 170/255, 23/255, 1
        on_release:
            root.manager.transition.direction = "right"
            root.manager.current = "choose_type_account"

    GridLayout:
        cols:1
        spacing: 25
        padding: 25

        Label:
            id: title
            text: "Choose Your Tools !"
            color: "white"
            font_size: 50
            size_hint: .1,.1
            pos_hint: {"center_x":0.5, "y":0.3}
            outline_width: 3
            outline_color: (0, 0, 0, 1)

        ScrollView:
            bar_width: 5
            MDList:
                id: scroll
                md_bg_color: "wheat"

                TwoLineAvatarIconListItem:
                    id: p1
                    text: "Daily Diary"
                    secondary_text: "Write how your day went in you own personal space! (COMING SOON!)"
                    icon: "pencil"

                    IconLeftWidget:
                        id: i1
                        icon: "pencil"

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p110
                            on_active:
                                root.check_click(self, self.active, root.ids.p1.text)
                                #app.save_checked(*args,root.ids.mm1.text,root.ids.mm1.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p2
                    text: "Emotions Diary"
                    secondary_text: "Track your mood every single day!"
                    icon: "emoticon-happy"

                    IconLeftWidget:
                        id: i2
                        icon: "emoticon-happy" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p210
                            on_active:
                                root.check_click(self, self.active, root.ids.p2.text)
                                #app.save_checked(*args,root.ids.mm2.text,root.ids.mm2.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p3
                    text: "Acknowledgements Diary"
                    secondary_text: "Put down all your past accomplishments, present struggles and future dreams! (COMING SOON!)"
                    icon: "star-box-outline"

                    IconLeftWidget:
                        id: i3
                        icon: "star-box-outline" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p310
                            on_active:
                                root.check_click(self, self.active, root.ids.p3.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p4
                    text: "To-Do List"
                    secondary_text: "List all your personal chores and do them one by one!"
                    icon: "check-decagram"

                    IconLeftWidget:
                        id: i4
                        icon: "check-decagram" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p410
                            on_active:
                                root.check_click(self, self.active, root.ids.p4.text)
                                #app.save_checked(*args,root.ids.mm3.text,root.ids.mm3.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p5
                    text: "Scheduler"
                    secondary_text: "Keep track of your routine and daily tasks! (COMING SOON!)"
                    icon: "view-list"

                    IconLeftWidget:
                        id: i5
                        icon: "view-list" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p510
                            on_active:
                                root.check_click(self, self.active, root.ids.p5.text)
                                #app.save_checked(*args,root.ids.mm4.text,root.ids.mm4.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p6
                    text: "Text To Speech"
                    secondary_text: "Another way to communicate freely!"
                    icon: "microphone"

                    IconLeftWidget:
                        id: i6
                        icon: "microphone" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p610
                            on_active:
                                root.check_click(self, self.active, root.ids.p6.text)
                                #app.save_checked(*args,root.ids.mm5.text,root.ids.mm5.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p7
                    text: "Shopping List"
                    secondary_text: "Don't forget your groceries!"
                    icon: "shopping"

                    IconLeftWidget:
                        id: i7
                        icon: "shopping" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p710
                            on_active:
                                root.check_click(self, self.active, root.ids.p7.text)
                                #app.save_checked(*args,root.ids.mm6.text,root.ids.mm6.secondary_text,root.ids.i1.icon,root)

                TwoLineAvatarIconListItem:
                    id: p8
                    text: "Book Manager"
                    secondary_text: "Have all your book titles in one place! (COMING SOON!)"
                    icon: "book"

                    IconLeftWidget:
                        id: i8
                        icon: "book" #root.icon

                    IconRightWidget:
                        icon: "resources/transparent.png"
                        MDCheckbox:
                            id: p810
